@page
@model Project.Web.Pages.Modelos.IndexModel
@{
    ViewData["Title"] = "Modelos";
}

<div class="card">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h2 class="h5 card-title mb-0">Modelos</h2>
        <a class="btn btn-primary" asp-page="/Modelos/Criar">Novo modelo</a>
    </div>
    @if (Model.Modelos.Count == 0)
    {
        <div class="card-body">
            <p class="ge-vazio">Nenhum modelo.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Nome</th>
                        <th scope="col" class="ge-acoes">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var modelo in Model.Modelos)
                    {
                        <tr>
                            <td>@modelo.Nome</td>
                            <td class="ge-acoes">
                                <a class="btn btn-sm btn-outline-primary" asp-page="/Modelos/Editar" asp-route-id="@modelo.Id">Editar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer text-secondary">@Model.Modelos.Count</div>
    }
</div>
