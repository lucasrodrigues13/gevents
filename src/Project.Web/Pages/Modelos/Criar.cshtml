@page
@model Project.Web.Pages.Modelos.CriarModel
@{
    ViewData["Title"] = "Novo modelo";
    ViewData["Secao"] = "Modelos";
    ViewData["SecaoUrl"] = "/Modelos";
}

<form method="post">
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    <div class="card">
        <div class="card-body">
            <div class="mb-3">
                <label asp-for="Nome" class="form-label ge-obrigatorio">Nome</label>
                <input asp-for="Nome" class="form-control" aria-required="true" />
            </div>
            <div class="mb-3">
                <label asp-for="Tipo" class="form-label ge-obrigatorio">Tipo</label>
                <select asp-for="Tipo" class="form-select" aria-required="true">
                    <option value="">Escolha o tipo</option>
                    <option value="Casamento">Casamento</option>
                    <option value="QuinzeAnos">15 anos</option>
                    <option value="Aniversario">Aniversário</option>
                    <option value="Corporativo">Corporativo</option>
                    <option value="Formatura">Formatura</option>
                </select>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">Salvar</button>
                <a class="btn btn-outline-secondary" asp-page="/Modelos/Index">Voltar</a>
            </div>
        </div>
    </div>
</form>
