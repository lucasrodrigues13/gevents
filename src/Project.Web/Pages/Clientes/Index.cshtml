@page
@model Project.Web.Pages.Clientes.IndexModel
@{
    ViewData["Title"] = "Clientes";
}

<div class="card">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h2 class="h5 card-title mb-0">Clientes</h2>
        <a class="btn btn-primary" asp-page="/Clientes/Criar">Novo cliente</a>
    </div>
    <div class="card-body border-bottom">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label" for="busca-cliente">Nome</label>
                <input id="busca-cliente" class="form-control" name="nome" value="@Model.Nome" placeholder="Nome" />
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-outline-primary">Buscar</button>
            </div>
        </form>
    </div>
    @if (Model.Clientes.Count == 0)
    {
        <div class="card-body">
            <p class="ge-vazio">Não há cliente para mostrar.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Nome</th>
                        <th scope="col">Telefone</th>
                        <th scope="col">E-mail</th>
                        <th scope="col">Eventos</th>
                        <th scope="col" class="ge-acoes">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cliente in Model.Clientes)
                    {
                        <tr>
                            <td><a asp-page="/Clientes/Editar" asp-route-id="@cliente.Id">@cliente.Nome</a></td>
                            <td>@cliente.Telefone</td>
                            <td>@cliente.Email</td>
                            <td>
                                @if (cliente.Eventos.Count == 0)
                                {
                                    <span>Nenhum evento vinculado</span>
                                }
                                @foreach (var evento in cliente.Eventos)
                                {
                                    <a asp-page="/Eventos/Home" asp-route-id="@evento.Id">@evento.Nome</a>
                                }
                            </td>
                            <td class="ge-acoes">
                                <a class="btn btn-sm btn-outline-primary" asp-page="/Clientes/Editar" asp-route-id="@cliente.Id">Editar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer text-secondary">@Model.Clientes.Count</div>
    }
</div>
