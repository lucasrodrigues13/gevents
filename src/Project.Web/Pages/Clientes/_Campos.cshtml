@model Project.Web.Clientes.ClienteInput
@using Project.Domain.Clientes

<div class="card mb-3">
    <div class="card-header"><h2 id="pessoais" class="h5 card-title mb-0">Dados pessoais</h2></div>
    <div class="card-body">
<div class="mb-3">
    <label asp-for="Nome" class="form-label ge-obrigatorio">Nome completo</label>
    <input asp-for="Nome" class="form-control" aria-required="true" />
</div>
<div class="mb-3">
    <label asp-for="Papel" class="form-label">Papel</label>
    <select asp-for="Papel" class="form-select">
        <option value="">Escolha o papel</option>
        @foreach (var papel in PapeisDeCliente.Todos)
        {
            <option value="@papel">@papel</option>
        }
    </select>
</div>
<div class="mb-3">
    <label asp-for="Nascimento" class="form-label">Nascimento</label>
    <input asp-for="Nascimento" class="form-control" />
</div>
<div class="mb-3">
    <label asp-for="Email" class="form-label">E-mail</label>
    <input asp-for="Email" class="form-control" />
</div>
<div class="mb-3">
    <label asp-for="Ddi" class="form-label">DDI</label>
    <input asp-for="Ddi" class="form-control" />
</div>
<div class="mb-3">
    <label asp-for="Celular" class="form-label">Celular</label>
    <input asp-for="Celular" class="form-control" />
</div>
<div class="mb-3">
    <label asp-for="TelefoneFixo" class="form-label">Telefone fixo</label>
    <input asp-for="TelefoneFixo" class="form-control" />
</div>
<div class="mb-3">
    <label asp-for="Cpf" class="form-label">CPF</label>
    <input asp-for="Cpf" class="form-control" />
</div>
<div class="mb-3">
    <label asp-for="Rg" class="form-label">RG</label>
    <input asp-for="Rg" class="form-control" />
</div>
<div class="mb-3">
    <label asp-for="Cnpj" class="form-label">CNPJ</label>
    <input asp-for="Cnpj" class="form-control" />
</div>
<div class="mb-3">
    <label asp-for="Profissao" class="form-label">Profissão</label>
    <input asp-for="Profissao" class="form-control" />
</div>
<div class="mb-3">
    <label asp-for="InscricaoMunicipal" class="form-label">Inscrição municipal</label>
    <input asp-for="InscricaoMunicipal" class="form-control" />
</div>
<div class="mb-3">
    <label asp-for="Religiao" class="form-label">Religião</label>
    <input asp-for="Religiao" class="form-control" />
</div>
<div class="mb-3">
    <label asp-for="Observacao" class="form-label">Observação</label>
    <textarea asp-for="Observacao" class="form-control"></textarea>
</div>
<div class="mb-3">
    <label asp-for="Imagem" class="form-label">Foto</label>
    <input asp-for="Imagem" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp" />
</div>
    </div>
</div>
<div class="card mb-3">
    <div class="card-header"><h2 id="redes" class="h5 card-title mb-0">Redes</h2></div>
    <div class="card-body">
<div class="mb-3">
    <label asp-for="Facebook" class="form-label">Facebook</label>
    <input asp-for="Facebook" class="form-control" />
</div>
<div class="mb-3">
    <label asp-for="Instagram" class="form-label">Instagram</label>
    <input asp-for="Instagram" class="form-control" />
</div>
    </div>
</div>
<div class="card mb-3">
    <div class="card-header"><h2 id="endereco" class="h5 card-title mb-0">Endereço</h2></div>
    <div class="card-body">
<div class="mb-3">
    <label asp-for="Pais" class="form-label">País</label>
    <input asp-for="Pais" class="form-control" />
</div>
<div class="mb-3">
    <label asp-for="Cep" class="form-label">CEP</label>
    <input asp-for="Cep" class="form-control" />
</div>
<div class="mb-3">
    <label asp-for="Logradouro" class="form-label">Endereço</label>
    <input asp-for="Logradouro" class="form-control" />
</div>
<div class="mb-3">
    <label asp-for="Numero" class="form-label">Número</label>
    <input asp-for="Numero" class="form-control" />
</div>
<div class="mb-3">
    <label asp-for="Estado" class="form-label">Estado</label>
    <input asp-for="Estado" class="form-control" />
</div>
<div class="mb-3">
    <label asp-for="Cidade" class="form-label">Cidade</label>
    <input asp-for="Cidade" class="form-control" />
</div>
<div class="mb-3">
    <label asp-for="Bairro" class="form-label">Bairro</label>
    <input asp-for="Bairro" class="form-control" />
</div>
<div class="mb-3">
    <label asp-for="Complemento" class="form-label">Complemento</label>
    <input asp-for="Complemento" class="form-control" />
</div>
    </div>
</div>
