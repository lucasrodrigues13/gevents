@page
@model Project.Web.Pages.Clientes.CriarModel
@{
    ViewData["Title"] = "Novo cliente";
    ViewData["Secao"] = "Clientes";
    ViewData["SecaoUrl"] = "/Clientes";
}

<form method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    <partial name="_Campos" for="Input" />
    <div class="d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-primary">Salvar</button>
        <a class="btn btn-outline-secondary" asp-page="/Clientes/Index">Voltar</a>
    </div>
</form>
