@page "{id:guid}"
@model Project.Web.Pages.Clientes.EditarModel
@{
    ViewData["Title"] = "Cliente";
    ViewData["Secao"] = "Clientes";
    ViewData["SecaoUrl"] = "/Clientes";
}

@if (!Model.Disponivel)
{
    <adminlte-alert theme="warning">O cliente não está disponível.</adminlte-alert>
}
else
{
    <form method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" role="alert"></div>
        <partial name="_Campos" for="Input" />
        <div class="d-flex flex-wrap gap-2 mb-4">
            <button type="submit" class="btn btn-primary">Salvar</button>
            <a class="btn btn-outline-secondary" asp-page="/Clientes/Index">Voltar</a>
        </div>
    </form>
    <div class="card">
        <div class="card-header"><h2 class="h5 card-title mb-0">Eventos</h2></div>
        <div class="card-body">
            @if (Model.Eventos.Count == 0)
            {
                <p class="ge-vazio">Nenhum evento vinculado.</p>
            }
            <ul class="list-group">
                @foreach (var evento in Model.Eventos)
                {
                    <li class="list-group-item"><a asp-page="/Eventos/Home" asp-route-id="@evento.Id">@evento.Nome</a></li>
                }
            </ul>
        </div>
    </div>
}
