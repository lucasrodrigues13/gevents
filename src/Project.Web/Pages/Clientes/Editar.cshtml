@page "{id:guid}"
@model Project.Web.Pages.Clientes.EditarModel
@{
    ViewData["Title"] = "Cliente";
}

@if (!Model.Disponivel)
{
    <p>O cliente não está disponível.</p>
}
else
{
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <partial name="_Campos" for="Input" />
        <button type="submit" class="btn btn-primary">Salvar</button>
    </form>
    <h2>Eventos</h2>
    @if (Model.Eventos.Count == 0)
    {
        <p>Nenhum evento vinculado.</p>
    }
    <ul>
        @foreach (var evento in Model.Eventos)
        {
            <li><a asp-page="/Eventos/Home" asp-route-id="@evento.Id">@evento.Nome</a></li>
        }
    </ul>
}
