@page
@model Project.Web.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Cadastro";
}

<h1 class="h4">Cadastro</h1>
<form method="post">
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    @if (Model.Warning is not null)
    {
        <adminlte-alert theme="warning">@Model.Warning</adminlte-alert>
    }
    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label ge-obrigatorio">E-mail</label>
        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" />
        <span asp-validation-for="Input.Email" class="invalid-feedback"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label ge-obrigatorio">Senha</label>
        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" />
        <span asp-validation-for="Input.Password" class="invalid-feedback"></span>
    </div>
    <button type="submit" class="btn btn-primary">Cadastrar</button>
</form>
