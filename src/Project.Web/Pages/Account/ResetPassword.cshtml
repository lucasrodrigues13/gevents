@page
@model Project.Web.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Nova senha";
}

<h1 class="h4">Nova senha</h1>
@if (Model.Completed)
{
    <adminlte-alert theme="success">Senha redefinida. Você já pode entrar.</adminlte-alert>
}
else
{
    <form method="post">
        <div asp-validation-summary="ModelOnly" role="alert"></div>
        <input type="hidden" asp-for="Input.Email" />
        <input type="hidden" asp-for="Input.Code" />
        <div class="mb-3">
            <label asp-for="Input.Password" class="form-label ge-obrigatorio">Nova senha</label>
            <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" />
            <span asp-validation-for="Input.Password" class="invalid-feedback"></span>
        </div>
        <button type="submit" class="btn btn-primary">Salvar</button>
    </form>
}
