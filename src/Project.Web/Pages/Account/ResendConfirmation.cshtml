@page
@model Project.Web.Pages.Account.ResendConfirmationModel
@{
    ViewData["Title"] = "Reenviar confirmação";
}

<h1 class="h4">Reenviar confirmação</h1>
@if (Model.Message is not null)
{
    <adminlte-alert theme="info">@Model.Message</adminlte-alert>
}
<form method="post">
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label ge-obrigatorio">E-mail</label>
        <input asp-for="Input.Email" class="form-control" aria-required="true" />
        <span asp-validation-for="Input.Email" class="invalid-feedback"></span>
    </div>
    <button type="submit" class="btn btn-primary">Reenviar</button>
</form>
