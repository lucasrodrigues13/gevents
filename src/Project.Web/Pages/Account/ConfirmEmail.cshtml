@page
@model Project.Web.Pages.Account.ConfirmEmailModel
@{
    ViewData["Title"] = "Confirmação";
}

<h1>Confirmação</h1>
@{
    var tema = Model.Confirmed ? "success" : "danger";
}
<adminlte-alert theme="@tema">@Model.Message</adminlte-alert>
@if (!Model.Confirmed)
{
    <p><a asp-page="/Account/ResendConfirmation">Pedir outro link</a></p>
}
