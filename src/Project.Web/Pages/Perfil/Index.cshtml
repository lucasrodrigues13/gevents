@page
@model Project.Web.Pages.Perfil.IndexModel
@{
    ViewData["Title"] = "Perfil";
}

@if (Model.Message is not null)
{
    <adminlte-alert theme="success">@Model.Message</adminlte-alert>
}
<form method="post">
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label" for="perfil-email">E-mail</label>
                    <input id="perfil-email" class="form-control" value="@Model.Email" disabled />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.NomeEmpresa" class="form-label">Nome da empresa</label>
                    <input asp-for="Input.NomeEmpresa" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.Responsavel" class="form-label">Responsável</label>
                    <input asp-for="Input.Responsavel" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.Documento" class="form-label">CPF ou CNPJ</label>
                    <input asp-for="Input.Documento" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.Celular" class="form-label">Celular</label>
                    <input asp-for="Input.Celular" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.Nascimento" class="form-label">Nascimento</label>
                    <input asp-for="Input.Nascimento" class="form-control" />
                </div>
                <div class="col-12 mb-3">
                    <label asp-for="Input.Endereco" class="form-label">Endereço</label>
                    <input asp-for="Input.Endereco" class="form-control" />
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Salvar</button>
        </div>
    </div>
</form>
