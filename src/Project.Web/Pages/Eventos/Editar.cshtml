@page "{id:guid}"
@model Project.Web.Pages.Eventos.EditarModel
@{
    ViewData["Title"] = "Editar evento";
}

@if (!Model.Disponivel)
{
    <p>O evento não está disponível.</p>
}
else
{
    @if (!Model.Aberto)
    {
        <p>O evento não está em andamento.</p>
    }
    <form method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <partial name="_Campos" for="Input" />
        @if (Model.Aberto)
        {
            <button type="submit" class="btn btn-primary">Salvar</button>
        }
        <a asp-page="/Eventos/Home" asp-route-id="@RouteData.Values["id"]">Voltar</a>
    </form>
}
