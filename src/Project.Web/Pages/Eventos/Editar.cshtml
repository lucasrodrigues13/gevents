@page "{id:guid}"
@model Project.Web.Pages.Eventos.EditarModel
@{
    ViewData["Title"] = "Editar evento";
    ViewData["Secao"] = "Eventos";
    ViewData["SecaoUrl"] = "/Eventos";
    ViewData["AbasEvento"] = true;
}

@if (!Model.Disponivel)
{
    <adminlte-alert theme="warning">O evento não está disponível.</adminlte-alert>
}
else
{
    @if (!Model.Aberto)
    {
        <adminlte-alert theme="warning">O evento não está em andamento.</adminlte-alert>
    }
    <form method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" role="alert"></div>
        <div class="card">
            <div class="card-body">
                <partial name="_Campos" for="Input" />
                <div class="d-flex flex-wrap gap-2">
                    @if (Model.Aberto)
                    {
                        <button type="submit" class="btn btn-primary">Salvar</button>
                    }
                    <a class="btn btn-outline-secondary" asp-page="/Eventos/Home" asp-route-id="@RouteData.Values["id"]">Voltar</a>
                </div>
            </div>
        </div>
    </form>
}
