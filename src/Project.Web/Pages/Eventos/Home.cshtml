@page "{id:guid}"
@using Project.Domain.Eventos
@using Project.Web.Eventos
@using Project.Web.Ui
@model Project.Web.Pages.Eventos.HomeModel
@{
    ViewData["Title"] = Model.Detalhe?.Nome ?? "Evento";
    ViewData["Secao"] = "Eventos";
    ViewData["SecaoUrl"] = "/Eventos";
}

@if (Model.Detalhe is null)
{
    <adminlte-alert theme="warning">O evento não está disponível.</adminlte-alert>
}
else
{
    @if (Model.Aviso is not null)
    {
        <adminlte-alert theme="info">@Model.Aviso</adminlte-alert>
    }
    <p class="mb-3"><partial name="_BadgeEvento" model="Model.Detalhe.Situacao" /></p>
    <div class="row g-3 mb-3">
        <div class="col-sm-6 col-xl-3">
            <div class="info-box">
                <span class="info-box-icon text-bg-primary"><i class="bi bi-calendar-event"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">
                        @if (Model.Detalhe.Data is DateOnly data)
                        {
                            @data.ToString("dd/MM/yyyy")
                        }
                    </span>
                    <span class="info-box-number">@EventoTexto.Contagem(Model.Detalhe.Data, Model.Hoje)</span>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="info-box">
                <span class="info-box-icon text-bg-success"><i class="bi bi-check2-square"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">Tarefas concluídas: @Model.Detalhe.Indicadores.TarefasConcluidas</span>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="info-box">
                <span class="info-box-icon text-bg-warning"><i class="bi bi-hourglass"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">Convidados pendentes: @Model.Detalhe.Indicadores.ConvidadosPendentes</span>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="info-box">
                <span class="info-box-icon text-bg-info"><i class="bi bi-person-check"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">Convidados confirmados: @Model.Detalhe.Indicadores.ConvidadosConfirmados</span>
                </div>
            </div>
        </div>
    </div>
    <p>Não comparecerá: @Model.Detalhe.Indicadores.ConvidadosNaoComparecera</p>
    <div class="card mb-3">
        <div class="card-body">
            @if (Model.Detalhe.Hora is TimeOnly hora)
            {
                <p>@hora.ToString("HH:mm")</p>
            }
            @if (EventoTexto.Tipo(Model.Detalhe.Tipo) is string tipo)
            {
                <p>@tipo</p>
            }
            @foreach (var tag in Model.Detalhe.Tags)
            {
                <span class="badge text-bg-secondary">@tag</span>
            }
            <p>Casal: @Model.Detalhe.CasalNome</p>
            <p>@Model.Detalhe.CasalPapel</p>
            <p>@Model.Detalhe.CasalEmail</p>
            <p>@Model.Detalhe.CasalCelular</p>
            <p>Orçamento estimado: @Model.Detalhe.OrcamentoEstimado</p>
            <p>Convidados estimados: @Model.Detalhe.ConvidadosEstimados</p>
            <p>@Model.Detalhe.LocalCerimonia</p>
            <p>@Model.Detalhe.LocalRecepcao</p>
            @if (Model.Detalhe.Mapa is not null)
            {
                <p><a href="@Model.Detalhe.Mapa">Mapa</a></p>
            }
            @if (Model.Detalhe.Compromisso is not null)
            {
                <p>Compromisso: @Model.Detalhe.Compromisso</p>
            }
            <p>URL do site</p>
            @foreach (var copia in Model.Copias)
            {
                <p>@copia</p>
            }
            @if (Model.Detalhe.ArquivoId is not null)
            {
                <p><a asp-page="/Eventos/Imagem" asp-route-id="@Model.Detalhe.Id">Imagem</a></p>
            }
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2 mb-3">
        <a class="btn btn-outline-primary" asp-page="/Eventos/Tarefas/Index" asp-route-id="@Model.Detalhe.Id">Tarefas do evento</a>
        <a class="btn btn-outline-primary" asp-page="/Eventos/Convites/Index" asp-route-id="@Model.Detalhe.Id">Convites</a>
        <a class="btn btn-outline-primary" asp-page="/Clientes/Index">Clientes</a>
    </div>
    <div class="card mb-3">
        <div class="card-header"><h2 class="h5 card-title mb-0">Clientes do evento</h2></div>
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" role="alert"></div>
            @if (Model.ClientesDoEvento.Count == 0)
            {
                <p class="ge-vazio">Nenhum cliente vinculado.</p>
            }
            <ul class="list-group mb-3">
                @foreach (var cliente in Model.ClientesDoEvento)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                        <span>@cliente.Nome</span>
                        <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#desvincular-@cliente.Id">Desvincular</button>
                    </li>
                }
            </ul>
            <form method="post" asp-page-handler="Vincular" asp-route-id="@Model.Detalhe.Id" class="row g-2 align-items-end">
                <div class="col-md-8">
                    <label class="form-label" for="vincular-cliente">Cliente</label>
                    <select id="vincular-cliente" class="form-select" name="clienteId">
                        <option value="">Cliente</option>
                        @foreach (var cliente in Model.ClientesDaConta)
                        {
                            <option value="@cliente.Id">@cliente.Nome</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-outline-primary">Vincular</button>
                </div>
            </form>
            <p class="mt-3 mb-0"><a asp-page="/Clientes/Criar" asp-route-eventoId="@Model.Detalhe.Id">Cadastrar novo</a></p>
        </div>
    </div>
    <div class="card mb-3">
        <div class="card-body">
            <form method="post" asp-page-handler="GerarLink" asp-route-id="@Model.Detalhe.Id">
                <button type="submit" class="btn btn-outline-primary">Gerar link</button>
            </form>
            @if (Model.LinkCadastro is Guid link)
            {
                <p class="mt-3 mb-0">/Cadastro/@link</p>
            }
        </div>
    </div>
    @if (Model.Detalhe.Situacao == SituacaoEvento.EmAndamento)
    {
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-primary" asp-page="/Eventos/Editar" asp-route-id="@Model.Detalhe.Id">Editar</a>
            <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modal-concluir">Concluir</button>
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#modal-cancelar">Cancelar</button>
        </div>
        <partial name="_ModalConfirmacao" model="@(new ModalConfirmacao { Id = "modal-concluir", Titulo = "Concluir evento", Mensagem = "Concluir este evento?", Pagina = "/Eventos/Home", Handler = "Concluir", RegistroId = Model.Detalhe.Id, Registro = Model.Detalhe.Nome, Aberto = Model.Confirmar == "concluir" })" />
        <partial name="_ModalConfirmacao" model="@(new ModalConfirmacao { Id = "modal-cancelar", Titulo = "Cancelar evento", Mensagem = "Cancelar este evento?", Pagina = "/Eventos/Home", Handler = "Cancelar", RegistroId = Model.Detalhe.Id, Registro = Model.Detalhe.Nome, Perigo = true, Aberto = Model.Confirmar == "cancelar" })" />
    }
    @foreach (var cliente in Model.ClientesDoEvento)
    {
        <div class="modal fade" id="desvincular-@cliente.Id" tabindex="-1" aria-labelledby="desvincular-titulo-@cliente.Id" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="desvincular-titulo-@cliente.Id">Desvincular cliente</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                    </div>
                    <form method="post" asp-page-handler="Desvincular" asp-route-id="@Model.Detalhe.Id">
                        <div class="modal-body">
                            <p class="mb-0">@cliente.Nome deixa de aparecer neste evento.</p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Voltar</button>
                            <input type="hidden" name="clienteId" value="@cliente.Id" />
                            <button type="submit" class="btn btn-danger">Desvincular</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}
