@page "{id:guid}"
@using Project.Domain.Eventos
@using Project.Web.Tarefas
@model Project.Web.Pages.Eventos.Tarefas.IndexModel
@{
    ViewData["Title"] = "Tarefas";
    ViewData["Secao"] = "Eventos";
    ViewData["SecaoUrl"] = "/Eventos";
}

@if (Model.Evento is null)
{
    <adminlte-alert theme="warning">O evento não está disponível.</adminlte-alert>
}
else
{
    <p>Tarefas de @Model.Evento.Nome</p>
    <p><a class="btn btn-outline-primary btn-sm" asp-page="/Tarefas/Index">Todas as tarefas</a></p>
    <p>Responsável: @Model.Email</p>
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    @if (Model.Tarefas.Count == 0)
    {
        <p class="ge-vazio">Não há tarefa para mostrar.</p>
    }
    <div class="card mb-3">
        <div class="card-header"><h2 class="h5 card-title mb-0">Lista</h2></div>
        @if (Model.Tarefas.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Título</th>
                            <th scope="col">Situação</th>
                            <th scope="col">Prazo</th>
                            <th scope="col">Descrição</th>
                            <th scope="col" class="ge-acoes">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tarefa in Model.Tarefas)
                        {
                            <tr>
                                <td><a asp-page="/Eventos/Tarefas/Editar" asp-route-id="@tarefa.Id">@tarefa.Titulo</a></td>
                                <td><partial name="_BadgeTarefa" model="tarefa.Situacao" /></td>
                                <td>
                                    @if (tarefa.Prazo is DateOnly prazo)
                                    {
                                        @prazo.ToString("dd/MM/yyyy")
                                    }
                                </td>
                                <td>@tarefa.Descricao</td>
                                <td class="ge-acoes">
                                    <a class="btn btn-sm btn-outline-primary" asp-page="/Eventos/Tarefas/Editar" asp-route-id="@tarefa.Id">Editar</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    <h2 class="h5">Quadro</h2>
    <div class="row g-3 mb-3">
        @foreach (var coluna in TarefaTexto.Colunas)
        {
            <section class="col-md-6 col-xl-3" id="coluna-@coluna">
                <div class="card h-100">
                    <div class="card-header"><h3 class="h6 card-title mb-0">@TarefaTexto.Situacao(coluna)</h3></div>
                    @{
                        var itens = Model.Tarefas.Where(item => item.Situacao == coluna).ToList();
                    }
                    @if (itens.Count == 0)
                    {
                        <div class="card-body"><p class="ge-vazio">Não há tarefa nesta coluna.</p></div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var tarefa in itens)
                            {
                                <li class="list-group-item">@tarefa.Titulo</li>
                            }
                        </ul>
                    }
                </div>
            </section>
        }
    </div>
    @if (Model.Evento.Situacao == SituacaoEvento.EmAndamento)
    {
        <form method="post">
            <div class="card">
                <div class="card-header"><h2 class="h5 card-title mb-0">Nova tarefa</h2></div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Input.Titulo" class="form-label ge-obrigatorio">Título</label>
                        <input asp-for="Input.Titulo" class="form-control" aria-required="true" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Descricao" class="form-label">Descrição</label>
                        <textarea asp-for="Input.Descricao" class="form-control"></textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Prazo" class="form-label">Prazo</label>
                        <input asp-for="Input.Prazo" class="form-control" type="date" />
                    </div>
                    <button type="submit" class="btn btn-primary">Salvar</button>
                </div>
            </div>
        </form>
    }
}
