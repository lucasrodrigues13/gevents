@page "{id:guid}"
@using Project.Web.Tarefas
@model Project.Web.Pages.Eventos.Tarefas.EditarModel
@{
    ViewData["Title"] = "Tarefa";
    ViewData["Secao"] = "Tarefas";
    ViewData["SecaoUrl"] = "/Tarefas";
}

@if (!Model.Disponivel)
{
    <adminlte-alert theme="warning">A tarefa não está disponível.</adminlte-alert>
}
else
{
    <p>@Model.EventoNome</p>
    <p>Responsável: @Model.Email</p>
    @if (!Model.Aberto)
    {
        <adminlte-alert theme="warning">O evento não está em andamento.</adminlte-alert>
    }
    <form method="post">
        <div asp-validation-summary="ModelOnly" role="alert"></div>
        <div class="card">
            <div class="card-body">
                <div class="mb-3">
                    <label asp-for="Input.Titulo" class="form-label ge-obrigatorio">Título</label>
                    <input asp-for="Input.Titulo" class="form-control" aria-required="true" />
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Descricao" class="form-label">Descrição</label>
                    <textarea asp-for="Input.Descricao" class="form-control"></textarea>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Prazo" class="form-label">Prazo</label>
                    <input asp-for="Input.Prazo" class="form-control" type="date" />
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Situacao" class="form-label">Situação</label>
                    <select asp-for="Input.Situacao" class="form-select">
                        @foreach (var situacao in TarefaTexto.Colunas)
                        {
                            <option value="@situacao">@TarefaTexto.Situacao(situacao)</option>
                        }
                    </select>
                </div>
                @if (Model.Aberto)
                {
                    <button type="submit" class="btn btn-primary">Salvar</button>
                }
            </div>
        </div>
    </form>
}
