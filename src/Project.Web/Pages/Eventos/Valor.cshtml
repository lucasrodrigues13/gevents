@page "{id:guid}"
@model Project.Web.Pages.Eventos.ValorModel
@{
    ViewData["Title"] = "Valor da assessoria";
    ViewData["Secao"] = "Eventos";
    ViewData["SecaoUrl"] = "/Eventos";
}

@if (Model.Nome is null)
{
    <adminlte-alert theme="warning">O evento não está disponível.</adminlte-alert>
}
else
{
    @if (Model.Aviso is not null)
    {
        <adminlte-alert theme="info">@Model.Aviso</adminlte-alert>
    }
    <p class="mb-3">@Model.Nome</p>
    <form method="post">
        <div asp-validation-summary="ModelOnly" role="alert"></div>
        <div class="card">
            <div class="card-header"><h2 class="h5 card-title mb-0">Assessoria e Organização</h2></div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="ValorTotal" class="form-label">Valor total</label>
                        <input asp-for="ValorTotal" class="form-control" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Quantidade" class="form-label">Quantidade de parcelas</label>
                        <input asp-for="Quantidade" class="form-control" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Primeira" class="form-label">Data da primeira parcela</label>
                        <input asp-for="Primeira" class="form-control" />
                    </div>
                </div>
                <div class="mb-3 form-check">
                    <input asp-for="ComEntrada" class="form-check-input" data-ge-toggle="entrada-assessoria" />
                    <label asp-for="ComEntrada" class="form-check-label">Entrada</label>
                </div>
                <div id="entrada-assessoria" class="@(Model.ComEntrada ? null : "d-none")">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="BaseEntrada" class="form-label">Base da entrada</label>
                            <select asp-for="BaseEntrada" class="form-select">
                                <option value="Valor">Valor</option>
                                <option value="Porcentagem">Porcentagem</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Entrada" class="form-label">Valor da entrada</label>
                            <input asp-for="Entrada" class="form-control" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="DataEntrada" class="form-label">Data da entrada</label>
                            <input asp-for="DataEntrada" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-primary">Gerar parcelas</button>
                    <a class="btn btn-outline-secondary" asp-page="/Eventos/Home" asp-route-id="@RouteData.Values["id"]">Agora não</a>
                </div>
            </div>
        </div>
    </form>
}
