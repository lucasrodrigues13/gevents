@page "{id:guid}"
@model Project.Web.Pages.Eventos.ImagemModel
@{
    ViewData["Title"] = "Imagem";
}

@if (Model.EventoDaConta)
{
    <adminlte-alert theme="warning">A imagem não está disponível.</adminlte-alert>
}
else
{
    <adminlte-alert theme="warning">O evento não está disponível.</adminlte-alert>
}
