@page
@model Project.Web.Pages.Grupos.IndexModel
@{
    ViewData["Title"] = "Grupos";
}

<div class="card mb-3">
    <div class="card-header"><h2 class="h5 card-title mb-0">Grupos</h2></div>
    @if (Model.Grupos.Count == 0)
    {
        <div class="card-body">
            <p class="ge-vazio">Não há grupo para mostrar.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Nome</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var grupo in Model.Grupos)
                    {
                        <tr>
                            <td>@grupo.Nome</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer text-secondary">@Model.Grupos.Count</div>
    }
</div>
<form method="post">
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    <div class="card">
        <div class="card-header"><h2 class="h5 card-title mb-0">Novo grupo</h2></div>
        <div class="card-body">
            <div class="mb-3">
                <label asp-for="Nome" class="form-label ge-obrigatorio">Nome</label>
                <input asp-for="Nome" class="form-control" aria-required="true" />
            </div>
            <button type="submit" class="btn btn-primary">Salvar</button>
        </div>
    </div>
</form>
