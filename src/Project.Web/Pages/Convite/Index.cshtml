@page "{link:guid}"
@using Project.Domain.Convites
@using Project.Web.Convites
@model Project.Web.Pages.Convite.IndexModel
@{
    Layout = "_LayoutPublico";
    ViewData["Title"] = "Presença";
}

@if (Model.Convite is null)
{
    <adminlte-alert theme="warning">O convite não está disponível.</adminlte-alert>
}
else
{
    <h1>@Model.Convite.Nome</h1>
    @Html.AntiForgeryToken()
    @if (Model.Aviso is not null)
    {
        <adminlte-alert theme="info">@Model.Aviso</adminlte-alert>
    }
    @if (Model.Convite.Convidados.Count == 0)
    {
        <p class="ge-vazio">Não há quem responder.</p>
    }
    else if (Model.Convite.Respondido)
    {
        <ul>
            @foreach (var convidado in Model.Convite.Convidados)
            {
                <li>@convidado.Nome — @ConviteTexto.Situacao(convidado.Situacao)</li>
            }
        </ul>
    }
    else
    {
        <form method="post">
            @for (var indice = 0; indice < Model.Convite.Convidados.Count; indice++)
            {
                var convidado = Model.Convite.Convidados[indice];
                <fieldset class="mb-3">
                    <legend>@convidado.Nome</legend>
                    <input type="hidden" name="respostas[@indice].ConvidadoId" value="@convidado.Id" />
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" id="resposta-sim-@indice" name="respostas[@indice].Situacao" value="@SituacaoConvidado.Confirmado" />
                        <label class="form-check-label" for="resposta-sim-@indice">Confirmado</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" id="resposta-nao-@indice" name="respostas[@indice].Situacao" value="@SituacaoConvidado.NaoComparecera" />
                        <label class="form-check-label" for="resposta-nao-@indice">Não comparecerá</label>
                    </div>
                </fieldset>
            }
            <button type="submit" class="btn btn-primary">Enviar</button>
        </form>
    }
}
