<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - gevents</title>
    <partial name="_Estilos" />
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">
        <nav class="app-header navbar navbar-expand bg-body" aria-label="Conta">
            <div class="container-fluid">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <button type="button" class="nav-link" data-lte-toggle="sidebar" aria-label="Abrir ou fechar o menu">
                            <i class="bi bi-list"></i>
                        </button>
                    </li>
                </ul>
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item dropdown">
                        <button type="button" class="nav-link dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                            @User.Identity?.Name
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-page="/Perfil/Index">Perfil</a></li>
                            <li>
                                <form method="post" asp-page="/Account/Logout">
                                    <button type="submit" class="dropdown-item">Sair</button>
                                </form>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </nav>
        <adminlte-sidebar />
        <div class="sidebar-overlay"></div>
        <main class="app-main">
            <div class="app-content-header">
                <div class="container-fluid">
                    <div class="row align-items-center">
                        <div class="col-sm-6">
                            <h1 class="mb-0 h3">@ViewData["Title"]</h1>
                        </div>
                        <div class="col-sm-6">
                            <nav aria-label="Trilha">
                                <ol class="breadcrumb float-sm-end mb-0">
                                    <li class="breadcrumb-item"><a asp-page="/Dashboards/Index">Início</a></li>
                                    @if (ViewData["Secao"] is string secao && !string.IsNullOrWhiteSpace(secao))
                                    {
                                        <li class="breadcrumb-item"><a href="@ViewData["SecaoUrl"]">@secao</a></li>
                                    }
                                    <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                                </ol>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
            <div class="app-content">
                <div class="container-fluid">
                    @if (TempData["Aviso"] is string aviso)
                    {
                        <div class="toast-container position-fixed top-0 end-0 p-3">
                            <div class="toast show text-bg-success" role="status" aria-live="polite">
                                <div class="toast-body d-flex align-items-center">
                                    <span class="me-auto">@aviso</span>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Fechar"></button>
                                </div>
                            </div>
                        </div>
                    }
                    @if (TempData["Erro"] is string erro)
                    {
                        <adminlte-alert theme="danger">@erro</adminlte-alert>
                    }
                    @RenderBody()
                </div>
            </div>
        </main>
        <footer class="app-footer">
            <span>gevents</span>
        </footer>
    </div>
    <partial name="_Scripts" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
