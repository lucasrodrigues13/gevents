@page
@model Project.Web.Pages.Dashboards.IndexModel
@{
    ViewData["Title"] = "Dashboards";
}

@if (Model.Eventos is null)
{
    <p>Não foi possível carregar os dashboards.</p>
}
else
{
    <h2>Eventos</h2>
    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <a class="card h-100 text-decoration-none text-body" asp-page="/Eventos/Index" asp-route-aba="emandamento">
                <div class="card-body">
                    <p class="text-secondary mb-1">Em andamento</p>
                    <p class="fs-3 fw-semibold mb-0">@Model.Eventos.EmAndamento</p>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a class="card h-100 text-decoration-none text-body" asp-page="/Eventos/Index" asp-route-aba="concluido">
                <div class="card-body">
                    <p class="text-secondary mb-1">Concluído</p>
                    <p class="fs-3 fw-semibold mb-0">@Model.Eventos.Concluidos</p>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a class="card h-100 text-decoration-none text-body" asp-page="/Eventos/Index" asp-route-aba="cancelado">
                <div class="card-body">
                    <p class="text-secondary mb-1">Cancelado</p>
                    <p class="fs-3 fw-semibold mb-0">@Model.Eventos.Cancelados</p>
                </div>
            </a>
        </div>
    </div>
    @if (Model.Eventos.ListaEmAndamento.Count == 0)
    {
        <p>Não há evento para mostrar.</p>
    }
    else
    {
        <div class="card mb-4">
            <ul class="list-group list-group-flush">
                @foreach (var evento in Model.Eventos.ListaEmAndamento)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <a asp-page="/Eventos/Home" asp-route-id="@evento.Id">@evento.Nome</a>
                        @if (evento.Data is DateOnly data)
                        {
                            <span class="text-secondary">@data.ToString("dd/MM/yyyy")</span>
                        }
                    </li>
                }
            </ul>
        </div>
    }
    <h2>Funil</h2>
    <div class="row g-3">
        @foreach (var cartao in Model.Funil)
        {
            <div class="col-md-3">
                <article class="card h-100">
                    <div class="card-body">
                        <p class="text-secondary mb-1">@cartao.Estagio</p>
                        <p class="mb-1">Quantidade: @cartao.Quantidade</p>
                        <p class="mb-0">Valor: @cartao.Valor</p>
                    </div>
                </article>
            </div>
        }
    </div>
}
