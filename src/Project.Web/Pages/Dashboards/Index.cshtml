@page
@model Project.Web.Pages.Dashboards.IndexModel
@{
    ViewData["Title"] = "Dashboards";
}

@if (Model.Eventos is null)
{
    <adminlte-alert theme="danger">Não foi possível carregar os dashboards.</adminlte-alert>
}
else
{
    <h2 class="h4">Eventos</h2>
    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <div class="small-box text-bg-primary">
                <div class="inner">
                    <h3>@Model.Eventos.EmAndamento</h3>
                    <p>Em andamento</p>
                </div>
                <i class="small-box-icon bi bi-calendar-event" aria-hidden="true"></i>
                <a class="small-box-footer link-light link-underline-opacity-0 link-underline-opacity-50-hover" asp-page="/Eventos/Index" asp-route-aba="emandamento">Abrir</a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="small-box text-bg-success">
                <div class="inner">
                    <h3>@Model.Eventos.Concluidos</h3>
                    <p>Concluído</p>
                </div>
                <i class="small-box-icon bi bi-check2-circle" aria-hidden="true"></i>
                <a class="small-box-footer link-light link-underline-opacity-0 link-underline-opacity-50-hover" asp-page="/Eventos/Index" asp-route-aba="concluido">Abrir</a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="small-box text-bg-danger">
                <div class="inner">
                    <h3>@Model.Eventos.Cancelados</h3>
                    <p>Cancelado</p>
                </div>
                <i class="small-box-icon bi bi-x-circle" aria-hidden="true"></i>
                <a class="small-box-footer link-light link-underline-opacity-0 link-underline-opacity-50-hover" asp-page="/Eventos/Index" asp-route-aba="cancelado">Abrir</a>
            </div>
        </div>
    </div>
    @if (Model.Eventos.ListaEmAndamento.Count == 0)
    {
        <p>Não há evento para mostrar.</p>
    }
    else
    {
        <div class="card mb-4">
            <div class="card-header"><h3 class="h5 card-title mb-0">Em andamento</h3></div>
            <ul class="list-group list-group-flush">
                @foreach (var evento in Model.Eventos.ListaEmAndamento)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <a asp-page="/Eventos/Home" asp-route-id="@evento.Id">@evento.Nome</a>
                        @if (evento.Data is DateOnly data)
                        {
                            <span class="text-secondary">@data.ToString("dd/MM/yyyy")</span>
                        }
                    </li>
                }
            </ul>
        </div>
    }
    <h2 class="h4">Funil</h2>
    <div class="row g-3">
        @foreach (var cartao in Model.Funil)
        {
            <div class="col-sm-6 col-xl-3">
                <article class="card h-100">
                    <div class="card-body">
                        <p class="text-secondary mb-1">@cartao.Estagio</p>
                        <p class="mb-1">Quantidade: @cartao.Quantidade</p>
                        <p class="mb-0">Valor: @cartao.Valor</p>
                    </div>
                </article>
            </div>
        }
    </div>
}
