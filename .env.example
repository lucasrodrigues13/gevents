# Copie para .env e preencha. O .env não entra no Git.
# Na VPS o caminho é /opt/gevents/.env
# No seu computador, o mesmo arquivo ao lado do compose.yaml libera o e-mail do ambiente local.

# Domínio que aponta para o IP da VPS. Sem https:// e sem barra.
# Exemplo: testes.seudominio.com
DOMAIN=

# Banco. A porta não é publicada. Evite os caracteres $ e ; na senha.
POSTGRES_USER=gevents
POSTGRES_PASSWORD=
POSTGRES_DB=gevents

# Pelo menos 32 caracteres. Gere na VPS com: openssl rand -base64 48
JWT_SECRET=

# Gmail: smtp.gmail.com, porta 587, senha de app (não é a senha da conta).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_STARTTLS=true
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=

# true só no primeiro deploy, para criar o administrador. Depois volte para false.
# A senha precisa de 8 caracteres e de uma letra minúscula.
BOOTSTRAP_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
